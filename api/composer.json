{
    "name": "pizzaria-forno-e-lenha/api",
    "description": "Projeto para avaliação da disciplina de Projeto Integrador de Sistemas",
    "type": "project",
    "scripts": {
        "start": "php -S localhost:8080",
        "start:test" : [
            "@putenv APP_ENV=testing",
            "php -S localhost:8081"
        ],
        "setup" : [
            "composer i",
            "php setup-bd.php",
            "@db:reset"
        ],
        "phinx": "vendor/bin/phinx",
        "db:reset": [
            "phinx rollback -t 0",
            "phinx migrate",
            "phinx seed:run"
        ],
        "db:reset-test": [
            "phinx rollback -e testing -t 0",
            "phinx migrate -e testing",
            "phinx seed:run -e testing"
        ],
        "test": [
            "@db:reset-test",
            "kahlan --reporter=verbose"
        ],
        "st": "phpstan analyze src --level=7",
        "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php"
    },
    "config": {
        "process-timeout": 0
    },
    "autoload": {
        "psr-4": {
            "": [
                "src/",
                "src/cliente/dominio/",
                "src/cliente/dto/",
                "src/cliente/repositorio/",
                "src/configuracao-fidelidade/dominio/",
                "src/configuracao-fidelidade/repositorio/",
                "src/entregador/dominio/",
                "src/entregador/repositorio/",
                "src/infra/db/",
                "src/infra/exceptions/",
                "src/infra/factory/",
                "src/infra/http/",
                "src/infra/sessao/",
                "src/ingrediente/dominio/",
                "src/ingrediente/repositorio/",
                "src/movimentacao-estoque/dominio/",
                "src/movimentacao-estoque/repositorio/",
                "src/pedido/dominio/",
                "src/pedido/dto/",
                "src/pedido/repositorio/",
                "src/pizza/dominio/",
                "src/pizza/dto/",
                "src/pizza/repositorio/",
                "src/produto-simples/dominio/",
                "src/produto-simples/dto/",
                "src/produto-simples/repositorio/",
                "src/promocao/dominio/",
                "src/promocao/dto/",
                "src/promocao/repositorio/",
                "src/usuario/dominio/",
                "src/usuario/repositorio/",
                "spec/factory/"
            ]
        }
    },
    "authors": [
        {
            "name": "Artur Alves",
            "email": "artur.oliveira@aluno.cefet-rj.br"
        },
        {
            "name": "Guilherme Rosa",
            "email": "guilherme.rosa.1@aluno.cefet-rj.br"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "kahlan/kahlan": "^6.1"
    },
    "require": {
        "robmorgan/phinx": "^0.16.12",
        "phputil/router": "^0.4.0",
        "phputil/cors": "^0.5.3",
        "vlucas/phpdotenv": "^5.7"
    }
}