{
    "name": "pizzaria-forno-e-lenha/api",
    "description": "Projeto para avaliação da disciplina de Projeto Integrador de Sistemas",
    "type": "project",
    "scripts": {
        "start": "php -S localhost:8080",
        "phinx": "vendor/bin/phinx",
        "test": "kahlan",
        "st": "phpstan analyze src --level=6",
        "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php"
    },
    "config": {
        "process-timeout": 0
    },
    "autoload": {
        "psr-4": {
            "": [
                "src/",
                "src/cliente/dominio/",
                "src/cliente/dto/",
                "src/cliente/repositorio/",
                "src/configuracao-fidelidade/dominio/",
                "src/configuracao-fidelidade/repositorio/",
                "src/endereco/dominio/",
                "src/endereco/repositorio/",
                "src/entregador/dominio/",
                "src/entregador/repositorio/",
                "src/infra/db/",
                "src/infra/exceptions/",
                "src/ingrediente/dominio/",
                "src/ingrediente/repositorio/",
                "src/ingrediente-adicional/dominio/",
                "src/ingrediente-adicional/repositorio/",
                "src/pedido/dominio/",
                "src/pedido/dto/",
                "src/pedido/repositorio/",
                "src/pizza/dominio/",
                "src/pizza/dto/",
                "src/pizza/repositorio/",
                "src/produto-simples/dominio/",
                "src/produto-simples/dto/",
                "src/produto-simples/repositorio/",
                "src/promocao/dominio/",
                "src/promocao/dto/",
                "src/promocao/repositorio/"
            ]
        }
    },
    "authors": [
        {
            "name": "Artur Alves",
            "email": "artur.oliveira@aluno.cefet-rj.br"
        },
        {
            "name": "Guilherme Rosa",
            "email": "guilherme.rosa.1@aluno.cefet-rj.br"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "kahlan/kahlan": "^6.1"
    },
    "require": {
        "robmorgan/phinx": "^0.16.12",
        "phputil/router": "^0.4.0",
        "phputil/cors": "^0.5.3",
        "vlucas/phpdotenv": "^5.7"
    }
}
